FROM node:22-alpine
WORKDIR /app/backend
ENV NODE_ENV=production
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
WORKDIR /app
COPY backend/server ./backend/server
COPY backend/web ./backend/web
COPY backend/scripts ./backend/scripts
COPY frontend ./frontend
RUN mkdir -p /data && chown -R node:node /data /app
USER node
ENV WEB_HOST=0.0.0.0 WEB_PORT=4173 AGENT_MARKET_DB_PATH=/data/agent-market.sqlite
EXPOSE 4173
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD node -e "fetch('http://127.0.0.1:4173/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "backend/web/index.js"]
