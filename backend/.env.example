# 배포용 환경 변수. 실제 값은 .env에 두고 커밋하지 않는다.

# --- 백엔드 ---
# demo: 로컬 개발. X-User-Id 헤더를 그대로 믿음 / strict: 배포. Agent는 토큰, Web 서버는 X-Web-Secret 필요
AGENT_MARKET_AUTH_MODE=strict
# Web 서버 ↔ API 서버 사이 공유 비밀 (16자 이상). 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AGENT_MARKET_WEB_SECRET=
# 브라우저에서 API를 직접 부른다면 Web 도메인으로 제한
AGENT_MARKET_CORS_ORIGIN=https://web.example.com
API_PORT=8080

# --- MCP (원격, Streamable HTTP) ---
# 승인 안내 문구에 들어갈 Web 주소
AGENT_MARKET_WEB_URL=https://web.example.com
MCP_PORT=8090
MCP_RATE_LIMIT_PER_MINUTE=120
