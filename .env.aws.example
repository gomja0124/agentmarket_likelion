# Copy to .env in the repository root on the EC2 host; never commit .env.
# This hostname must resolve to the EC2 public IP or an Elastic IP.
AGENT_MARKET_DOMAIN=market.example.com
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AGENT_MARKET_WEB_SECRET=
# Set to 1 only after Step 2 MCP tools are approved for the public service.
AGENT_MARKET_ENABLE_STEP2=0
